# Copy to .env.local for local development.
VITE_API_BASE=

# Stripe publishable key — required for the hosted CardElement payment form.
# The publishable key is safe to expose to the browser; it cannot initiate
# charges or access account data. Never put the SECRET key (sk_…) here.
# Get your key from https://dashboard.stripe.com/apikeys
# Use pk_test_… for development/staging, pk_live_… for production.
VITE_STRIPE_PUBLISHABLE_KEY=
